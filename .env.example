# Copy to .env for laptop development. Test funds only behind the local stand-in vault.
# local = stand-in vault in this process; turnkey = the Turnkey vault (run `npm run turnkey:setup` once first).
VAULT_MODE=local
# Leave unset: the stand-in vault makes its own random phrase and keeps it beside the saved state.
# LOCAL_VAULT_MNEMONIC=
STATE_PATH=./data/state.json
# The one account allowed to add liquidity to the swap pool (Will's account ID). Unset: anyone may.
# LIQUIDITY_PROVIDER=0x...
PORT=8080

# Login. standin: a test key kept in the browser (laptop work). google: Continue with Google, one Turnkey wallet per user.
# Google mode needs TURNKEY_ORG_ID (Will's organization) and the Google client ID, and a one-time
# `npm run turnkey:signup-setup` that registers the app's sign-up key (shown on /api/status) in Will's organization.
LOGIN_MODE=standin
# GOOGLE_CLIENT_ID=295336183237-90umhku3e7jck9tktd5dikc6ru7bc2he.apps.googleusercontent.com
# SESSION_SECONDS=28800

# At least two independent providers per chain, comma-separated. Public defaults are used if unset.
# SEPOLIA_RPC_URLS=https://eth-sepolia.g.alchemy.com/v2/KEY,https://ethereum-sepolia-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URLS=https://base-sepolia.g.alchemy.com/v2/KEY,https://base-sepolia-rpc.publicnode.com
SEPOLIA_CONFIRMATIONS=3
BASE_SEPOLIA_CONFIRMATIONS=10
WITHDRAWAL_CAP_ETH=0.05

# Turnkey. The three parent settings are Will's organization and API key; only `turnkey:setup` and
# `turnkey:check` use them. The app itself runs on its own keys, kept beside STATE_PATH.
# TURNKEY_ORG_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# Optional: setup records the vault's sub-organization ID beside STATE_PATH.
# TURNKEY_VAULT_ORG_ID=
