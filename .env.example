# Copy to .env for laptop development. Never put real funds behind the local vault.
VAULT_MODE=local
LOCAL_VAULT_MNEMONIC="test test test test test test test test test test test junk"
STATE_PATH=./data/state.json
PORT=8080

# At least two independent providers per chain, comma-separated. Public defaults are used if unset.
# SEPOLIA_RPC_URLS=https://eth-sepolia.g.alchemy.com/v2/KEY,https://ethereum-sepolia-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URLS=https://base-sepolia.g.alchemy.com/v2/KEY,https://base-sepolia-rpc.publicnode.com
SEPOLIA_CONFIRMATIONS=3
BASE_SEPOLIA_CONFIRMATIONS=10
WITHDRAWAL_CAP_ETH=0.05
